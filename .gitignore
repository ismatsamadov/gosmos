# Build output
build/
.build/
.swiftpm/

# Only authored course and reference databases belong in the repository.
*.sqlite
*.sqlite3
*.db
!courses/*.sqlite
!reference/*.sqlite

# SQLite's transient files never belong in source control.
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Personal study data and drafts belong to the local app, never the repository.
learner.sqlite*
.learner.sqlite.*

.DS_Store
