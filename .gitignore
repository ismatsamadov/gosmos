# Build output
/build/
.build/
.swiftpm/

# No database belongs in the repository but the Go reference: a course library is built from its
# folder of text (make library), courses/apogee/ into courses/apogee.sqlite.
*.sqlite
*.sqlite3
*.db
!reference/*.sqlite

# A library folder keeps every file its lessons give, whatever the name, and vendor/ every file
# go mod vendor puts there.
!courses/[!.]*/**
!vendor/**

# SQLite's transient files never belong in source control.
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Personal study data and drafts belong to the local app, never the repository.
learner.sqlite*
.learner.sqlite.*

.DS_Store

# Editors' own settings stay on their machine.
.vscode/
