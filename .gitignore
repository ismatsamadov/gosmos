# Build output
build/
.build/
.swiftpm/

# No database belongs in the repository but the Go reference: a course library is built from its
# folder of text (make library), courses/apogee/ into courses/apogee.sqlite.
*.sqlite
*.sqlite3
*.db
!reference/*.sqlite

# SQLite's transient files never belong in source control.
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Personal study data and drafts belong to the local app, never the repository.
learner.sqlite*
.learner.sqlite.*

.DS_Store
